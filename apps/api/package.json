{
  "name": "@finora/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ../../scripts/expo-lan.mjs api-dev",
    "test": "node --test scripts/dev-network-auth.test.mjs && jest --runInBand",
    "start": "node ../../scripts/expo-lan.mjs api-start",
    "test:auth:local": "node scripts/verify-auth-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@better-auth/expo": "1.6.35",
    "@finora/contracts": "workspace:*",
    "@finora/database": "workspace:*",
    "@finora/financial-engine": "workspace:*",
    "@finora/i18n": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.6.35",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "nodemailer": "8.0.11",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "7.0.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.0"
  }

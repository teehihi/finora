NODE_ENV=development
# Production requires HTTPS BETTER_AUTH_URL/WEB_ORIGINS, TLS SMTP,
# an absolute persistent LOCAL_STORAGE_PATH and HTTPS external AI endpoints.
# See deploy/.env.production.example and docs/architecture/DEPLOYMENT.md.
HOST=0.0.0.0
TRUST_PROXY_HOPS=0
PORT=3000
DATABASE_URL=postgresql://finora:finora_local_dev@localhost:5432/finora?schema=public
BETTER_AUTH_SECRET=
# Canonical auth URL (especially for OAuth callbacks); it does not follow Wi-Fi.
BETTER_AUTH_URL=http://localhost:3000
# Exact configured browser origins. Only local API dev adds current Expo LAN origins.
WEB_ORIGINS=http://localhost:8081
AI_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads

# Local OTP mail is captured by Mailpit, not delivered to real inboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=finora@example.test
SMTP_MODE=local
SMTP_USER=
SMTP_PASSWORD=
# Optional generic reminders; requires user opt-in and a verified email.
FINORA_REMINDER_EMAIL_ENABLED=false
# Server-only. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reserved Apple server integration; see docs/architecture/AUTHENTICATION.md.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=


# Intelligence 3.0 defaults to local deterministic mode. To opt into external
# interpretation, set AI_PROVIDER=openai and a server-only key. Only send
# current questions from the client after per-request consent. No uploaded
# documents, account records, stored profiles or prior history are sent.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_OUTPUT_TOKENS=450
OPENAI_RETRY_COUNT=1
OPENAI_RETRY_DELAY_MS=250
# Native Anthropic Messages API, including compatible gateways. This token stays server-only.
# Set AI_PROVIDER=anthropic to enable; each chat request still requires explicit consent.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_MS=12000
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_RETRY_COUNT=1
ANTHROPIC_RETRY_DELAY_MS=250
FINORA_AI_TIMEOUT_MS=24000
FINORA_AI_MAX_ROUNDS=2
FINORA_AI_REQUESTS_PER_MINUTE=12
FINORA_MATCH_WEIGHTS=35,25,20,10,10
FINORA_MATCH_AFFORDABILITY_TARGET=0.35
FINORA_MATCH_STRESS_PERCENT=20

# Optional local Tesseract recognition for JPEG/PNG and scanned PDF.
# Requires tesseract, pdftotext and pdftoppm on PATH plus installed vie/eng
# traineddata and tessdata/configs/tsv. Blank = manual OCR review.
DOCUMENT_OCR_LANGS=

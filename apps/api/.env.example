NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://finora:finora_local_dev@localhost:5432/finora?schema=public
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081
AI_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads

# Local OTP mail is captured by Mailpit, not delivered to real inboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=finora@example.test
SMTP_MODE=local
SMTP_USER=
SMTP_PASSWORD=
# Server-only. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reserved Apple server integration; see docs/architecture/AUTHENTICATION.md.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

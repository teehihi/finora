# Copy to deploy/.env.production, keep outside version control, and replace every placeholder.
FINORA_DOMAIN=finora.example.com
POSTGRES_USER=finora
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=finora
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY_HOPS=1
PORT=3000
BETTER_AUTH_URL=https://finora.example.com
WEB_ORIGINS=https://finora.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=finora@example.com
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
FINORA_REMINDER_EMAIL_ENABLED=false
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/uploads
DOCUMENT_OCR_LANGS=vie+eng

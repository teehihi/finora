{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_API_URL"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "EXPO_PUBLIC_API_URL",
        "FINORA_KEEP_LEGACY_LAN",
        "BETTER_AUTH_URL",
        "WEB_ORIGINS"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["DOCUMENT_OCR_LANGS", "TESSDATA_PREFIX"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@finora/app#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_API_URL", "EXPO_NO_DOTENV", "EXPO_NO_CLIENT_ENV_VARS"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/scripts/expo-lan.mjs"],
      "passThroughEnv": ["FINORA_KEEP_LEGACY_LAN"]
    }
  }
}
